# T-Stack — variabili d'ambiente (TEMPLATE, nessun segreto qui)
# Copia in .env.local per lo sviluppo e configura le stesse variabili su Vercel.
# I valori si trovano in Supabase → Project Settings → API (progetto "bussola").

# Pubbliche (client): URL del progetto e anon/publishable key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Solo server (SEGRETA, non esporre): usata da /api/reminders
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Segreto per proteggere l'endpoint cron dei promemoria
CRON_SECRET=<scegli-una-stringa-segreta>
